{
  "buildCommand": "vite build Frontend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://a-e-tech-project.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://a-e-tech-project.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
