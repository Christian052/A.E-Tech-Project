PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/aetech

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Cloudinary (image uploads) - optional for MVP, local disk storage used as fallback
CLOUDINARY_URL=

# Email notifications (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=augstintech2015@gmail.com
SMTP_PASS=app_password_here
NOTIFY_EMAIL=augstintech2015@gmail.com

# Seed admin user (used only by npm run seed)
SEED_ADMIN_NAME=Augustin
SEED_ADMIN_EMAIL=admin@aetech.rw
SEED_ADMIN_PASSWORD=ChangeMe123!